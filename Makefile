# TR ][: Apple ][ Plus emulator and our ROM.
#   make          build the ROM and the Mac terminal front end
#   make test     CPU functional test + Monitor checks (headless, no window)
#   make run      start the emulator in this terminal (Ctrl-] quits)
CC      = cc
CFLAGS  = -std=c99 -O2 -Wall -Wextra
EMU     = emu/cpu6502.c emu/a2.c emu/woz.c

all: build/tr-rom.bin build/blockcard.bin build/a2term

build:
	mkdir -p build

# rom/basic.s is Microsoft's BASIC-M6502, converted once by tools/m6502-to-ca65.py
# and edited by hand since ([OURS] lines). The converter is not run by make.
build/tr-rom.bin build/tr-ext.bin: rom/monitor.s rom/basic.s rom/rom.cfg | build
	ca65 -o build/monitor.o -l build/monitor.lst rom/monitor.s
	ca65 -o build/basic.o -l build/basic.lst rom/basic.s
	ld65 -C rom/rom.cfg -o build/tr-rom.bin -m build/rom.map build/monitor.o build/basic.o

build/blockcard.bin: rom/blockcard.s rom/card.cfg | build
	ca65 -o build/blockcard.o -l build/blockcard.lst rom/blockcard.s
	ld65 -C rom/card.cfg -o $@ build/blockcard.o

build/a2term: mac/a2term.c mac/dis6502.c mac/dis6502.h mac/speaker.c mac/speaker.h mac/sid-voice.c mac/sid-voice.h emu/tone.c emu/tone.h emu/stick.c emu/stick.h emu/diskimg.c emu/diskimg.h $(EMU) emu/cpu6502.h emu/a2.h emu/woz.h emu/badlist.h | build
	$(CC) $(CFLAGS) -o $@ mac/a2term.c mac/dis6502.c mac/speaker.c mac/sid-voice.c emu/tone.c emu/stick.c emu/diskimg.c $(EMU) -lm

build/cpu-test: tests/cpu-test.c emu/cpu6502.c emu/cpu6502.h | build
	$(CC) $(CFLAGS) -o $@ tests/cpu-test.c emu/cpu6502.c

# The disk image layer on its own (emu/diskimg.c, D1).
build/test-disk: tests/test-disk.c emu/diskimg.c emu/diskimg.h | build
	$(CC) $(CFLAGS) -o $@ tests/test-disk.c emu/diskimg.c

build/bootdisk.po: tests/bootdisk.s tests/bootdisk.cfg | build
	ca65 -o build/bootdisk.o tests/bootdisk.s
	ld65 -C tests/bootdisk.cfg -o $@ build/bootdisk.o

# Your own Oregon Trail (bring your own copy; never part of the repo): the SD card's copy for the TR is a block image plus
# the list of its unreadable blocks (block 8, the copy protection, answered with an I/O error). woz-to-po.py
# never overwrites, so this runs once; the WOZ itself is only read.
OT_WOZ = disks/the-oregon-trail-800-k.woz
SD_DISK = build/sd/OREGON.PO
$(SD_DISK): | $(OT_WOZ)
	mkdir -p build/sd
	python3 -I tools/woz-to-po.py $(OT_WOZ) --no-list --write $@ --bad-list build/sd/OREGON.BAD
ifneq ($(wildcard $(OT_WOZ)),)
OT_FILES = $(SD_DISK)
endif

test: build/cpu-test build/bootdisk.po build/test-disk all module-test $(OT_FILES)
	@if [ -f third-party/dormann/6502_functional_test.bin ]; then ./build/cpu-test; \
	 else echo "skip the CPU test (fetch Klaus Dormann's 6502 functional test into third-party/dormann/: see README.md)"; fi
	./tests/test-monitor.sh
	./tests/test-basic.sh
	python3 -I tests/applesoft-roundtrip.py
	./tests/test-oregon.sh
	./tests/test-sound.sh
	./tests/test-tone.sh
	./tests/test-joystick.sh
	./tests/test-disk.sh

# ---- TeensyROM+ module (step 4) ----
# Our ROMs as C arrays for the module.
build/rom-images.h: build/tr-rom.bin build/tr-ext.bin build/blockcard.bin
	cd build && { echo "// Generated by make from tr-rom.bin, tr-ext.bin and blockcard.bin. Do not edit."; \
	  xxd -i tr-rom.bin; xxd -i tr-ext.bin; xxd -i blockcard.bin; } | sed -e 's/^unsigned char/static const unsigned char/' \
	  -e '/_len = /d' > rom-images.h

# The program F5 types in (NEW, then the listing with Apple returns, then a NUL), as a C array.
build/demo-program.h: programs/cave-diver.txt | build
	{ printf 'NEW\r'; tr '\n' '\r' < programs/cave-diver.txt; printf '\0'; } > build/demo-program.bin
	cd build && { echo "// Generated by make from programs/cave-diver.txt. Do not edit."; \
	  xxd -i demo-program.bin; } | sed -e 's/^unsigned char/static const unsigned char/' \
	  -e '/_len = /d' > demo-program.h

# The Oregon Trail play-through's keys (tests/oregon-keys.sh) as plain text, for the module test.
build/oregon-keys.txt: tests/oregon-keys.sh | build
	bash -c '. tests/oregon-keys.sh; printf "%s" "$$KEYS"' > $@

# The real module source on the Mac, against upstream's native fake host.
build/test-module: teensy/test-module.cpp teensy/apple2-module.cpp emu/cpu6502.c emu/a2.c emu/a2.h emu/cpu6502.h emu/badlist.h emu/tone.c emu/tone.h emu/stick.c emu/stick.h emu/diskimg.c emu/diskimg.h build/rom-images.h build/demo-program.h build/oregon-keys.txt
	c++ -std=c++17 -O2 -Wall -Wextra -I teensyrom-build/vm/tests -o $@ teensy/test-module.cpp

module-test: build/test-module build/test-client
	mkdir -p build/module-sandbox
	./build/test-module build/module-sandbox
	./build/test-client build/apple2-client.bin build/apple2-client.sym

# The C64 client, assembled on its own (with symbols) for the client test.
build/apple2-client.bin: c64client/apple2-client.a | build
	acme --outfile $@ -f plain -l build/apple2-client.sym c64client/apple2-client.a

build/test-client: tests/test-client.c emu/cpu6502.c emu/cpu6502.h build/apple2-client.bin
	$(CC) $(CFLAGS) -o $@ tests/test-client.c emu/cpu6502.c

# The extension package (/VMS/<ID>), built by upstream's packager. Mac only.
# The TR will not overwrite a file, so a new build goes out under a new ID and file type
# (for example: make package ID=APPLE2K FTYPE=a2k) rather than deleting the old one.
ID     ?= APPLE2
FTYPE  ?= a2
EXT_OUT = $(CURDIR)/build/ext-$(ID)
package: build/rom-images.h build/demo-program.h c64client/apple2-client.a teensy/apple2-module.cpp
	cd teensyrom-build && node tools/build-extension.mjs --id $(ID) --extensions $(FTYPE) \
	  --source $(CURDIR)/teensy/apple2-module.cpp --client-source $(CURDIR)/c64client/apple2-client.a \
	  --services 0x401f --out $(EXT_OUT)

.PHONY: module-test package

run: all
	./build/a2term

.PHONY: all test run
